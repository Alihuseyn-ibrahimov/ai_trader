{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "ai_trader",
    "trading_mode": "spot",
    "margin_mode": "",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 2,
    "fiat_display_currency": "USD",
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "urls": {
                "api": {
                    "public": "https://data-api.binance.vision/api/v3"
                }
            },
            "options": {
                "fetchMarkets": {
                    "types": [
                        "spot"
                    ]
                }
            }
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "initial_state": "stopped",
    "internals": {
        "process_throttle_secs": 5
    },
    "ai_risk": {
        "risk_per_trade": 0.01,
        "daily_loss_limit": 0.03,
        "floor_ratio": 0.7,
        "max_open_trades": 2
    }
}
